# Gemini API Key for MindMesh AI Graph Generation
# Obtain an API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional model selection (defaults to gemini-3.6-flash)
# Supported options: gemini-3.6-flash, gemini-1.5-flash
GEMINI_MODEL=gemini-3.6-flash
